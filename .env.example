# Partner playground — same QA host as admin/user frontends.
# Token stays server-side (BFF). Do not prefix with NEXT_PUBLIC_.

NEXT_PUBLIC_API_URL=https://apiqa.socceraidolx.com
BACKEND_URL=https://apiqa.socceraidolx.com/api/v1
NEXT_PUBLIC_WS_URL=wss://apiqa.socceraidolx.com/api/v1

# Partner key minted in Admin → API Partners.
# If this token is missing/empty, the UI will not show the playground.
AIDOLS_API_TOKEN=ak_live_replace_me
